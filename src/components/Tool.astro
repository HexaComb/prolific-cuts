---
interface Props {
  tool?: "scissors" | "clippers" | "brush" | "comb";
  label?: string;
}

const { tool = "scissors", label } = Astro.props;
---

<div class="tool-badge" aria-hidden="true">
  <span class="tool-icon-wrap">
    <svg class:list={["tool", `tool-${tool}`]} viewBox="0 0 72 40" fill="none">
      {
        tool === "scissors" && (
          <>
            <g class="scissor-blade-top">
              <circle cx="13" cy="11" r="6.25" />
              <path d="M18.2 14.2 66 33" />
            </g>
            <g class="scissor-blade-bottom">
              <circle cx="13" cy="29" r="6.25" />
              <path d="M18.2 25.8 66 7" />
            </g>
            <circle cx="31.6" cy="20" r="2.25" fill="currentColor" stroke="none" />
          </>
        )
      }
      {
        tool === "clippers" && (
          <g class="clipper-body">
            <path d="M3 14.5h17.5V9.2H34v5.3h22.5c6.6 0 10.5 2.8 10.5 6.6S63.1 27.7 56.5 27.7H20.5v5.6H3z" />
            <path d="M3 21.2h17.5" />
            <path d="M6.2 27.7v5.2M10.4 27.7v5.2M14.6 27.7v5.2M18.6 27.7v5.2" />
            <circle cx="40" cy="20.8" r="2.35" fill="currentColor" stroke="none" />
          </g>
        )
      }
      {
        tool === "brush" && (
          <g class="brush-body">
            <path d="M3 20h24" />
            <path d="M27 12h9v16h-9z" />
            <path d="M36 13c10-.4 20-2 30-7" />
            <path d="M36 17.5c12 0 22 .4 30 1" />
            <path d="M36 22c11 .5 20 2 28 5" />
            <path d="M36 26.5c9 .8 16 2.4 22 6" />
          </g>
        )
      }
      {
        tool === "comb" && (
          <g class="comb-body">
            <path d="M18 10h48" />
            <path d="M18 10C6 12 4 24 14 28" />
            <path d="M24 10v16M32 10v20M40 10v16M48 10v20M56 10v16M64 10v20" />
          </g>
        )
      }
    </svg>
  </span>
  <span class="tool-rule"></span>
  {label && <span class="tool-tag">{label}</span>}
</div>

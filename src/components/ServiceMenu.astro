---
import { catalog, resolveService, shop } from "../data/shop";
---

<div class="space-y-14">
  {
    catalog.map((group, idx) => (
      <section id={group.id} class="scroll-mt-24" aria-labelledby={`${group.id}-title`}>
        <div class="flex flex-wrap items-baseline gap-3">
          <span class="service-num">0{idx + 1}</span>
          <h2 id={`${group.id}-title`} class="text-4xl sm:text-5xl">
            {group.title}
          </h2>
        </div>
        <p class="mt-3 max-w-prose text-lg">{group.lede}</p>
        <div class="menu-sheet mt-6 overflow-x-auto">
          <table class="w-full min-w-[40rem] text-left">
            <caption class="sr-only">{group.title} at Prolific Cuts</caption>
            <thead>
              <tr class="border-b-2 border-current/25 font-display text-sm tracking-wider uppercase">
                <th class="py-3 pr-4 font-semibold" scope="col">Service</th>
                <th class="py-3 pr-4 font-semibold" scope="col">Barber</th>
                <th class="py-3 pr-4 font-semibold" scope="col">Time</th>
                <th class="py-3 pr-4 font-semibold" scope="col">Price</th>
                <th class="py-3 font-semibold" scope="col">
                  <span class="sr-only">Book</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {group.items.map((ref) => {
                const { barber, service } = resolveService(ref);
                return (
                  <tr class="menu-row border-b border-current/15 align-top last:border-b-0">
                    <th class="py-4 pr-4 font-sans font-medium normal-case tracking-normal" scope="row">
                      <div class="text-lg font-semibold">{service.name}</div>
                      {service.detail && <div class="mt-1 font-normal opacity-80">{service.detail}</div>}
                    </th>
                    <td class="py-4 pr-4">
                      <a class="draw font-medium underline underline-offset-4" href={`/barbers/${barber.slug}`}>
                        {barber.name}
                      </a>
                    </td>
                    <td class="py-4 pr-4 whitespace-nowrap">
                      <span class="time-stamp">{service.time}</span>
                    </td>
                    <td class="py-4 pr-4 whitespace-nowrap">
                      {service.promoPrice && (
                        <span class="mr-2 line-through opacity-70">{service.listPrice}</span>
                      )}
                      <span class="price-badge">{service.promoPrice ?? service.listPrice}</span>
                    </td>
                    <td class="py-4 text-right whitespace-nowrap">
                      <a class="draw font-display text-sm tracking-wider uppercase underline underline-offset-4" href={barber.booksy}>
                        Book on Booksy ↗
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
  <p class="text-sm opacity-80">{shop.priceNote}</p>
</div>

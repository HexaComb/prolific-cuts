---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServiceMenu from "../components/ServiceMenu.astro";
import Pole from "../components/Pole.astro";
import Tool from "../components/Tool.astro";
import { shop, squareMenu } from "../data/shop";

const description =
  "Haircuts, beard work, kids’ cuts, hot towel shaves, and color at Prolific Cuts in Clovis. Real time in the chair with your neighborhood barbers—see times, prices, and booking links.";
---

<Base title="Services | Prolific Cuts, Clovis" description={description}>
  <Header />
  <main id="content" class="band-cream">
    <header class="mx-auto w-full max-w-6xl px-4 pt-16 pb-10">
      <h1 class="cut text-5xl text-balance sm:text-6xl">Services</h1>
      <Tool tool="scissors" />
      <p class="mt-6 max-w-prose text-lg">
        Real time in the chair with the barber you trust. All nine of our barbers book core services
        on Square, and Diego, Roger, and Nic also keep their full menus on Booksy.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-fill" href="/#book">Book a chair</a>
        <a class="btn btn-line" href={shop.phoneHref}>{shop.phone}</a>
      </div>
    </header>
    <Pole />
    <div class="mx-auto w-full max-w-6xl space-y-16 px-4 pt-16 pb-20">
      <section aria-labelledby="square-menu">
        <h2 id="square-menu" class="text-4xl sm:text-5xl">Square</h2>
        <p class="mt-4 max-w-prose text-lg">
          Core shop services, available across our crew. Pick a service to choose your barber.
        </p>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[28rem] text-left">
            <caption class="sr-only">Square services at Prolific Cuts</caption>
            <thead>
              <tr class="border-b border-current/20 text-sm tracking-wide uppercase">
                <th class="py-3 pr-4 font-medium" scope="col">Service</th>
                <th class="py-3 pr-4 font-medium" scope="col">Time</th>
                <th class="py-3 font-medium" scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {
                squareMenu.map((service) => (
                  <tr class="border-b border-current/15 align-top">
                    <th class="py-4 pr-4 font-sans font-medium normal-case tracking-normal" scope="row">
                      <a class="underline underline-offset-4" href={service.href}>{service.name}</a>
                      {service.detail && <div class="mt-1 font-normal opacity-80">{service.detail}</div>}
                    </th>
                    <td class="py-4 pr-4 whitespace-nowrap">{service.time}</td>
                    <td class="py-4 whitespace-nowrap">{service.price}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
      <section aria-labelledby="booksy-menu">
        <h2 id="booksy-menu" class="text-4xl sm:text-5xl">Booksy</h2>
        <p class="mt-4 max-w-prose text-lg">
          Diego, Roger, and Nic also keep extended menus on Booksy. Crossed-out prices show the
          regular list price alongside the current Booksy rate.
        </p>
        <div class="mt-8">
          <ServiceMenu />
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>

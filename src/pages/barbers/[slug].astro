---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { barbers, getBarber, shop, squareServicesFor } from "../../data/shop";
import Pole from "../../components/Pole.astro";
import Tool from "../../components/Tool.astro";

export function getStaticPaths() {
  return barbers.map((barber) => ({ params: { slug: barber.slug } }));
}

const { slug } = Astro.params;
const barber = getBarber(slug ?? "");
if (!barber) {
  throw new Error(`Unknown barber: ${slug}`);
}

const chairNumber = barbers.findIndex((b) => b.slug === barber.slug) + 1;
const squareServices = squareServicesFor(barber.slug);
const title = `${barber.name} | Barber at Prolific Cuts, Clovis`;
const description = `Book ${barber.name} at Prolific Cuts, 493 W Shaw Ave, Ste A, Clovis, on Square.`;
---

<Base title={title} description={description}>
  <Header />
  <main id="content" class="band-cream">
    <header class="mx-auto grid w-full max-w-6xl grid-cols-[7.5rem_1fr] items-start gap-6 px-4 pt-16 pb-12 sm:grid-cols-[13rem_1fr] sm:gap-10">
      <div class="ig-tile p-2">
        <div class="ig-frame">
          <img
            src={barber.photo}
            alt=""
            width="352"
            height="469"
            class="aspect-[3/4] w-full object-cover"
          />
          <Pole class="absolute inset-x-0 bottom-0" />
        </div>
        <div class="ig-footer">
          <span class="ig-tag">
            <span class="ig-tag-bar" />
            Chair 0{chairNumber}
          </span>
          {barber.slug === "peda-thik" && <span class="ig-arrow">Owner</span>}
        </div>
      </div>
      <div>
        <p class="mb-2">
          <a class="section-index draw" href="/">
            ← Prolific Cuts
          </a>
        </p>
        <h1 class="cut text-5xl text-balance sm:text-6xl">{barber.name}</h1>
        <Tool tool="clippers" label={`Chair 0${chairNumber} • Clovis`} />
        {barber.bio && <p class="shop-note-card mt-5 max-w-prose text-lg">{barber.bio}</p>}
        {
          barber.instagram && (
            <p class="mt-4">
              <a class="draw font-medium underline underline-offset-4" href={barber.instagram}>
                {barber.slug === "peda-thik" ? "@pedacuts" : "Instagram"} ↗
              </a>
            </p>
          )
        }
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-fill" href={barber.square}>Book on Square</a>
          <a class="btn btn-line" href={shop.maps}>{shop.address}</a>
        </div>
      </div>
    </header>
    <Pole />
    <div class="mx-auto w-full max-w-6xl space-y-16 px-4 pt-16 pb-20">
      <section aria-labelledby="square-heading">
        <p class="section-index">01 / Square Appointments</p>
        <h2 id="square-heading" class="text-4xl sm:text-5xl">Book with {barber.shortName}</h2>
        <p class="mt-4 max-w-prose text-lg">
          Pull up a chair with {barber.shortName} on Square. Each service below shows the time
          blocked out for your appointment and the starting price. {shop.priceNote}
        </p>
        <div class="menu-sheet mt-6 overflow-x-auto">
          <table class="w-full min-w-[32rem] text-left">
            <caption class="sr-only">{barber.name} on Square</caption>
            <thead>
              <tr class="border-b-2 border-current/25 font-display text-sm tracking-wider uppercase">
                <th class="py-3 pr-4 font-semibold" scope="col">Service</th>
                <th class="py-3 pr-4 font-semibold" scope="col">Time</th>
                <th class="py-3 font-semibold" scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {
                squareServices.map((service) => (
                  <tr class="menu-row border-b border-current/15 align-top last:border-b-0">
                    <th class="py-4 pr-4 font-sans font-medium normal-case tracking-normal" scope="row">
                      <a class="draw text-lg font-semibold underline underline-offset-4" href={service.href}>{service.name}</a>
                      {service.detail && <div class="mt-1 font-normal opacity-80">{service.detail}</div>}
                    </th>
                    <td class="py-4 pr-4 whitespace-nowrap">
                      <span class="time-stamp">{service.time}</span>
                    </td>
                    <td class="py-4 whitespace-nowrap">
                      <span class="price-badge">{service.price}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>

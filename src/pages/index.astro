---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Pole from "../components/Pole.astro";
import Tool from "../components/Tool.astro";
import { barbers, shop, squareMenu } from "../data/shop";
import { instagram } from "../data/instagram";

const description =
  "Prolific Cuts is your neighborhood barbershop at 493 W Shaw Ave in Clovis. Pull up a chair with good people for fresh fades, classic cuts, beard work, and kids’ haircuts.";
---

<Base title="Prolific Cuts | Your Neighborhood Barbershop in Clovis" description={description}>
  <Header />
  <main id="content">
    <section
      class="relative isolate flex min-h-[calc(100svh-5rem)] items-center bg-[url('/video/hero-poster.jpg')] bg-cover bg-center"
      aria-label="Prolific Cuts"
    >
      <video
        id="hero-video"
        class="absolute inset-0 size-full object-cover motion-reduce:hidden"
        autoplay
        muted
        loop
        playsinline
        poster="/video/hero-poster.jpg"
        preload="metadata"
      >
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
      <div class="scrim absolute inset-0"></div>
      <div class="relative z-10 mx-auto w-full max-w-4xl px-4 py-20 text-center">
        <h1 class="cut text-[clamp(3.5rem,10vw,6rem)] text-balance">Prolific Cuts</h1>
        <p class="cut cut-2 mx-auto mt-6 max-w-xl text-lg text-balance sm:text-xl">
          Your neighborhood barbershop on Shaw Ave. Good people, good conversation, and an amazing cut.
        </p>
        <div class="cut cut-3 mt-10 flex flex-wrap items-center justify-center gap-3">
          <a class="btn btn-fill" href="#book">Book a chair</a>
          <a class="btn btn-line" href="#services">See services</a>
        </div>
      </div>
      <button
        id="hero-pause"
        class="btn btn-line scrim-solid absolute right-4 bottom-4 z-10 min-h-10 px-3 text-base"
        type="button"
        aria-pressed="false"
      >
        Pause video
      </button>
      <Pole class="absolute inset-x-0 bottom-0 z-10" />
    </section>

    <section id="shop" class="band-cream scroll-mt-24" aria-labelledby="shop-heading">
      <div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-24 md:grid-cols-[0.9fr_1.1fr] md:items-start">
        <div>
          <h2 id="shop-heading" class="text-5xl text-balance sm:text-6xl">The shop on Shaw</h2>
          <Tool tool="brush" />
        </div>
        <div class="max-w-prose space-y-4 text-lg">
          <p class="text-xl">
            Pull up a chair, hang out with good people, and get a cut you feel great about. Nobody’s
            rushing you out the door—just local barbers who take their time and know their regulars
            by name.
          </p>
          <p>
            Find us at <a class="underline underline-offset-4" href={shop.maps}>{shop.address}, {shop.locality}</a>.
            Walk-ins are always welcome, or <a class="underline underline-offset-4" href="#book">book a chair</a> with
            your go-to barber.
          </p>
          <p>
            Everyone’s welcome here, including kids and first haircuts. The shop is wheelchair
            accessible, and our neighbors have us at <a class="underline underline-offset-4" href={shop.booksy}>{shop.booksyRating} on Booksy</a>.
          </p>
        </div>
      </div>
    </section>

    <section id="chair" class="scroll-mt-24" aria-labelledby="chair-heading">
      <div class="mx-auto w-full max-w-6xl px-4 py-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl space-y-4">
            <h2 id="chair-heading" class="text-5xl text-balance sm:text-6xl">From the chair</h2>
            <Tool tool="clippers" />
            <p class="max-w-prose text-lg">
              Fresh cuts and familiar faces from our
              <a class="underline underline-offset-4" href={instagram.href}>Instagram</a>.
            </p>
          </div>
          <a class="btn btn-line" href={instagram.href}>Instagram</a>
        </div>
        <ul class="ig-board">
          {
            instagram.posts.map((post) => (
              <li>
                <a class="ig-tile" href={post.href}>
                  <img
                    src={post.src}
                    alt={post.alt}
                    width="640"
                    height="640"
                    style={`object-position: ${post.position}`}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="services" class="band-cream scroll-mt-24" aria-labelledby="services-heading">
      <div class="mx-auto w-full max-w-6xl px-4 py-24">
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div class="max-w-3xl space-y-4">
            <h2 id="services-heading" class="text-5xl text-balance sm:text-6xl">Services</h2>
            <Tool tool="scissors" />
            <p class="max-w-prose text-lg">
              No rush, no guesswork. Every service blocks out real time in the chair. Book with any
              barber on Square, or <a class="underline underline-offset-4" href="/services">see the full menu</a>.
            </p>
          </div>
          <a class="btn btn-line" href={shop.squareAppointments}>Book on Square</a>
        </div>
        <ul class="mt-12 grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
          {
            squareMenu.map((service) => (
              <li class="service-cell flex flex-col gap-4 bg-background p-6">
                <h3 class="text-3xl">{service.name}</h3>
                {service.detail && <p class="text-muted-foreground">{service.detail}</p>}
                <p class="mt-auto flex items-baseline justify-between gap-3 text-lg">
                  <span>{service.time}</span>
                  <span>{service.price}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Pole />
    <section id="book" class="band-cream scroll-mt-24" aria-labelledby="book-heading">
      <div class="mx-auto w-full max-w-6xl px-4 py-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl space-y-4">
            <h2 id="book-heading" class="text-5xl text-balance sm:text-6xl">Book a chair</h2>
            <Tool tool="comb" />
            <p class="text-lg">
              Nine local barbers, each running their own chair. Book anyone on Square—Diego, Roger,
              and Nic are also on Booksy. Walk on in if a chair is open, or give us a call.
            </p>
          </div>
          <a class="btn btn-line" href={shop.phoneHref}>{shop.phone}</a>
        </div>
        <ul class="barber-board">
          {
            barbers.map((barber) => (
              <li class="barber-card">
                <div class="barber-photo">
                  <img
                    src={barber.photo}
                    alt=""
                    width="176"
                    height="235"
                    class="block h-full w-full object-cover"
                  />
                  <Pole class="absolute inset-x-0 bottom-0" />
                </div>
                <h3 class="barber-name">
                  <a class="draw" href={`/barbers/${barber.slug}`}>
                    {barber.name}
                  </a>
                </h3>
                <div class="barber-meta">
                  {barber.bookingName && <p>Also on Booksy as {barber.bookingName}</p>}
                  {barber.rating && <p>{barber.rating}</p>}
                  {barber.gap && <p>{barber.gap}</p>}
                </div>
                <div class="barber-actions">
                  <a class="btn btn-fill" href={barber.square}>Book on Square</a>
                  {barber.booksy && (
                    <a class="btn btn-line" href={barber.booksy}>Book on Booksy</a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="visit" class="scroll-mt-24" aria-labelledby="visit-heading">
      <div class="mx-auto grid w-full max-w-6xl gap-12 px-4 py-24 md:grid-cols-2">
        <div class="space-y-4">
          <h2 id="visit-heading" class="text-5xl text-balance sm:text-6xl">Visit</h2>
          <Tool tool="brush" />
          <p class="text-xl">
            <a class="underline underline-offset-4" href={shop.maps}>
              {shop.address}<br />{shop.locality}
            </a>
          </p>
          <p class="max-w-prose">
            Swing by during shop hours for a walk-in, or <a class="underline underline-offset-4" href="#book">book ahead</a> to
            lock in your favorite barber. Give us a ring at
            <a class="underline underline-offset-4" href={shop.phoneHref}>{shop.phone}</a>
            if you’re coming right when we open.
          </p>
        </div>
        <dl class="divide-border border-y border-border divide-y">
          {
            shop.hours.map(([day, time]) => (
              <div class="flex items-baseline justify-between gap-4 py-4 text-lg">
                <dt>{day}</dt>
                <dd>{time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const bindHero = () => {
    const video = document.querySelector<HTMLVideoElement>("#hero-video");
    const button = document.querySelector<HTMLButtonElement>("#hero-pause");
    if (!video || !button || video.dataset.bound) return;
    video.dataset.bound = "true";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const setPaused = (paused: boolean) => {
      button.setAttribute("aria-pressed", String(paused));
      button.textContent = paused ? "Play video" : "Pause video";
    };

    const stop = () => {
      video.pause();
      video.removeAttribute("autoplay");
      setPaused(true);
    };

    if (reduced.matches) stop();

    button.addEventListener("click", () => {
      if (video.paused) {
        void video.play();
        setPaused(false);
      } else {
        video.pause();
        setPaused(true);
      }
    });

    reduced.addEventListener("change", () => {
      if (reduced.matches) stop();
    });
  };

  bindHero();
  document.addEventListener("astro:page-load", bindHero);
</script>
